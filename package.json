{
  "name": "comandi-escritorio",
  "productName": "Comandi",
  "version": "0.3.0",
  "description": "Comandi para el ordenador del restaurante: el tablero de pedidos con sus impresoras.",
  "main": "src/main.js",
  "author": "SCD TECH SL",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "es.comandi.escritorio",
    "productName": "Comandi",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Comandi-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Comandi",
      "artifactName": "Comandi-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sancascd",
        "repo": "comandi-escritorio",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sancascd/comandi-escritorio.git"
  }
}
